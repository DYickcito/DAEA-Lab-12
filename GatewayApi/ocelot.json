{
  "Routes": [
    {
      "UpstreamPathTemplate": "/gateway/auth/{everything}",
      "UpstreamHttpMethod": [ "Post" ],
      "DownstreamPathTemplate": "/api/auth/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [ { "Host": "localhost", "Port": 5120 } ]
    },
    {
      "UpstreamPathTemplate": "/gateway/especialidades{everything}",
      "UpstreamHttpMethod": [ "Get" ],
      "DownstreamPathTemplate": "/api/especialidades{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [ { "Host": "localhost", "Port": 5120 } ]
    },
    {
      "UpstreamPathTemplate": "/gateway/pacientes{everything}",
      "UpstreamHttpMethod": [ "Get" ],
      "DownstreamPathTemplate": "/api/pacientes{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [ { "Host": "localhost", "Port": 5120 } ]
    },
    {
      "UpstreamPathTemplate": "/gateway/especialidades{everything}",
      "UpstreamHttpMethod": [ "Post", "Put", "Delete" ],
      "DownstreamPathTemplate": "/api/especialidades{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [ { "Host": "localhost", "Port": 5120 } ],
      "AuthenticationOptions": { "AuthenticationProviderKeys": [ "Bearer" ] }
    },
    {
      "UpstreamPathTemplate": "/gateway/pacientes{everything}",
      "UpstreamHttpMethod": [ "Post", "Put", "Delete" ],
      "DownstreamPathTemplate": "/api/pacientes{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [ { "Host": "localhost", "Port": 5120 } ],
      "AuthenticationOptions": { "AuthenticationProviderKeys": [ "Bearer" ] }
    },
    {
      "UpstreamPathTemplate": "/gateway/citas{everything}",
      "UpstreamHttpMethod": [ "Get" ],
      "DownstreamPathTemplate": "/api/citas{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [ { "Host": "localhost", "Port": 5121 } ],
      "AuthenticationOptions": { "AuthenticationProviderKeys": [ "Bearer" ] }
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:5000"
  }
}
